{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "StreetThreadX product model",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "sku": { "type": "string" },
        "description": { "type": "string" },
        "materials": { "type": "string" },
        "category": { "type": "string", "enum": ["Hoodies", "T-Shirts", "Accessories", "Sweaters"] },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "variants": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "size": { "type": "string" },
              "color": { "type": "string" },
              "stock": { "type": "number" },
              "sku": { "type": "string" }
            }
          }
        },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Draft", "Published"] },
        "taxCategory": { "type": "string", "enum": ["Standard", "Reduced", "Exempt"] },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sales": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "description", "category", "images", "stock", "status"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Customer support live chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "CLOSED"] },
        "isPresenceActive": { "type": "boolean" },
        "lastPresenceUpdate": { "type": "string" }
      },
      "required": ["id", "customerName", "customerEmail", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "senderId", "text", "timestamp", "isAdmin"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of products available in the store"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Active and archived chat sessions"
    },
    "chatSessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within a chat session"
    }
  }
}
