rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'biplobnbc04@gmail.com' ||
        request.auth.token.email == 'parvesvai00@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'description', 'category', 'images', 'stock', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.description is string && data.description.size() <= 4000
        && data.category is string && data.category.size() <= 100
        && data.images is list && data.images.size() <= 20
        && data.stock is number && data.stock >= 0
        && data.status in ['Draft', 'Published'];
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // --- Customers Collection ---
    match /customers/{customerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && incoming().customerEmail == request.auth.token.email;
      allow update: if isAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
    }

    // --- Chat Sessions ---
    match /chatSessions/{sessionId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && (resource.data.customerEmail == request.auth.token.email || resource.data.userId == request.auth.uid || sessionId == ('guest_' + request.auth.uid)));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (existing().customerEmail == request.auth.token.email || existing().userId == request.auth.uid || sessionId == ('guest_' + request.auth.uid)));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow list, get: if isAdmin() || (
          isSignedIn() && 
          exists(/databases/$(database)/documents/chatSessions/$(sessionId)) && 
          (
            get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.customerEmail == request.auth.token.email || 
            get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid ||
            sessionId == ('guest_' + request.auth.uid)
          )
        );
        allow create: if isSignedIn();
      }
    }
  }
}
