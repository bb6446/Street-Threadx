rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // NOTE: For prototyping purposes, we hardcode allowed admin emails
      return isSignedIn() && (
        request.auth.token.email == 'biplobnbc04@gmail.com' ||
        request.auth.token.email == 'parvesvai00@gmail.com' ||
        request.auth.token.isCustomAdmin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if true; // Allows admins without Google Auth
      allow update: if true; // Allows customers to deduct stock
      allow delete: if true; // Allows admins without Google Auth
    }

    // --- Customers Collection ---
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // --- Expenses Collection ---
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // --- Config Collection ---
    match /config/{configId} {
      allow read, write: if true;
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read, write: if true; 
    }

    // --- Chat Sessions ---
    match /chatSessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // --- Newsletters Collection ---
    match /newsletters/{subscriptionId} {
      allow read, write: if true;
    }

    // --- Custom Forms ---
    match /custom_forms/{formId} {
      allow read, write: if true;
    }

    // --- Custom Form Submissions ---
    match /custom_form_submissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
