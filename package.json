{
  "name": "street-threadx.-streetwear",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "build:hosting": "vite build && node build-htdocs.js && node zip-htdocs.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.103.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^0.575.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-ga4": "^3.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "stripe": "^22.1.1",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.1",
    "firebase-tools": "^15.17.0",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "~5.8.2"
  }
}
